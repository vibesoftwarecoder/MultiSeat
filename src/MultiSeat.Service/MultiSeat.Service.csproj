<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MultiSeat.Service</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsWindowsService>true</IsWindowsService>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MultiSeat.Tests" />
  </ItemGroup>

  <!--
    Stamp the commit into the binary so a deployed service can say which source it was built
    from. Without this, "did my pull actually reach the service?" is unanswerable on the host -
    the question that cost a round trip on issue #18.

    ContinueOnError and the Exists guard matter: someone building from a source zip has no .git
    and no git on PATH, and that must produce an unstamped build, not a failed one.
  -->
  <!--
    The shipped version comes from version.txt at the repo root, so one file is the single
    answer to "what version is this" for the binary, the release title and the tag. The
    release workflow refuses to publish when the tag and this file disagree.

    Before 2026-09-09 there was no version file at all: releases were tagged v0.5.1 while the
    assembly reported 1.0.0, so the config inspector on a deployed host named a version that
    matched no release. Exists() guard: a source zip without version.txt still builds, just
    unversioned.
  -->
  <Target Name="ReadVersionFile" BeforeTargets="GetAssemblyVersion"
          Condition="Exists('$(MSBuildProjectDirectory)/../../version.txt')">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/../../version.txt">
      <Output TaskParameter="Lines" PropertyName="VersionFromFile" />
    </ReadLinesFromFile>
    <PropertyGroup Condition="'$(VersionFromFile)' != ''">
      <Version>$(VersionFromFile.Trim())</Version>
    </PropertyGroup>
  </Target>

  <Target Name="StampCommit" BeforeTargets="GetAssemblyVersion"
          Condition="Exists('$(MSBuildProjectDirectory)/../../.git')">
    <Exec Command="git rev-parse --short=9 HEAD" ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildCommit" />
    </Exec>
    <PropertyGroup Condition="'$(BuildCommit)' != ''">
      <SourceRevisionId>$(BuildCommit.Trim())</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.*" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.*" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.*" />
    <PackageReference Include="System.Management" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiSeat.Shared\MultiSeat.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
